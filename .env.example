# Environment selection (ec2, dev, qa)
TEST_ENV=dev

# Optional override for the application base URL
BASE_URL=https://dev.your-company-app.com

# Secure credentials for environments that require authentication
TEST_USERNAME=your_username
TEST_PASSWORD=your_password

# Optional login path and selectors if your login page differs from the defaults
LOGIN_PATH=/login
LOGIN_USERNAME_SELECTOR=input[name="username"]
LOGIN_PASSWORD_SELECTOR=input[name="password"]
LOGIN_SUBMIT_SELECTOR=button[type="submit"]
